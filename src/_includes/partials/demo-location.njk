{#- Location/date filter for the demo tabs; behavior in public/js/demo/location-filter.js -#}
{% macro locationFilter(id, labelKey, label) %}
<div class="demo-location" id="{{ id }}">
  <div class="d-flex align-items-center justify-content-between gap-2">
    <div class="form-check form-switch mb-0">
      <input class="form-check-input" type="checkbox" role="switch" id="{{ id }}-enable" data-role="enable">
      <label class="form-check-label small fw-medium" for="{{ id }}-enable"><span data-i18n="{{ labelKey }}">{{ label }}</span></label>
    </div>
    <span data-role="badge" class="badge" hidden></span>
  </div>
  <div data-role="fields" class="mt-2" hidden>
    <div class="demo-loc-grid">
      <label class="visually-hidden" for="{{ id }}-lat" data-i18n="demo.location.lat">Latitude</label>
      <input type="number" step="0.0001" min="-90" max="90" id="{{ id }}-lat" class="form-control form-control-sm" data-role="lat" placeholder="Latitude" data-i18n-placeholder="demo.location.lat">
      <label class="visually-hidden" for="{{ id }}-lon" data-i18n="demo.location.lon">Longitude</label>
      <input type="number" step="0.0001" min="-180" max="180" id="{{ id }}-lon" class="form-control form-control-sm" data-role="lon" placeholder="Longitude" data-i18n-placeholder="demo.location.lon">
      <label class="visually-hidden" for="{{ id }}-date" data-i18n="demo.location.date">Recording date</label>
      <input type="date" id="{{ id }}-date" class="form-control form-control-sm" data-role="date" title="Recording date" data-i18n-title="demo.location.date">
      <div class="demo-loc-btns">
        <button type="button" class="btn btn-sm btn-outline-primary" data-role="locate" title="Use my current location" aria-label="Use my current location" data-i18n-title="demo.settings.detectTitle" data-i18n-aria="demo.settings.detectTitle"><i class="bi bi-crosshair"></i></button>
        <button type="button" class="btn btn-sm btn-outline-primary" data-role="pick" title="Pick a location on the map" aria-label="Pick a location on the map" data-i18n-title="demo.location.pickTitle" data-i18n-aria="demo.location.pickTitle"><i class="bi bi-map"></i></button>
      </div>
    </div>
    <div class="small text-muted mt-1" data-role="summary"></div>
  </div>
</div>
{% endmacro %}
