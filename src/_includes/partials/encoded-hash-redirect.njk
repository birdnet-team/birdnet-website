{# Some mail clients (e.g. Outlook) write the # of a link like /demo/#birdbox as %23, which asks the server for a page
   that doesn't exist. Send such links on to the page and section they meant, before anything else loads. #}
<script>
  (function () {
    var path = location.pathname, i = path.search(/%23/i);
    if (i < 0) return;
    var hash = path.slice(i + 3);
    path = path.slice(0, i);
    if (!/(\/|\.html)$/.test(path)) path += '/';
    location.replace(path + location.search + '#' + hash);
  })();
</script>
